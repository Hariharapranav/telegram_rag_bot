# ==============================================================================
# Enterprise AI Telegram Assistant — Environment Configuration
# ==============================================================================

# Application Environment
APP_NAME="Enterprise AI Telegram Assistant"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Telegram Bot API Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_MODE=polling  # "polling" for local dev / easy setup, "webhook" for production
TELEGRAM_WEBHOOK_URL="" # e.g. "https://assistant.yourdomain.com/api/telegram/webhook"
TELEGRAM_SECRET_TOKEN="" # Optional custom secret token for webhook verification

# Supabase / PostgreSQL Database Connection
# If connecting directly to Supabase PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres.[project_ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# For local Docker Compose:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag"
# For zero-dependency local SQLite development:
# DATABASE_URL="sqlite+aiosqlite:///./enterprise_rag.db"

# Supabase Storage & Client
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="enterprise-documents"

# Redis Configuration (Semantic Cache & OTP store)
# For local Docker:
REDIS_URL="redis://localhost:6379/0"
# In local development without Redis, the app automatically uses an in-memory fallback!

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_SIMPLE="gemini-2.0-flash-lite"
GEMINI_MODEL_COMPLEX="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
EMBEDDING_DIMENSION=768

# Semantic Cache Settings
# Cosine similarity threshold (0.0 to 1.0) above which a cached answer is returned
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_SECONDS=86400  # 24 Hours

# RAG Retrieval Settings
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.45
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Authentication & OTP Settings
OTP_TTL_SECONDS=300 # 5 Minutes
# When MOCK_OTP_MODE is true, OTP is printed in console and shown as a hint in Telegram for easy demoing/testing
MOCK_OTP_MODE=true

# Super Bot Admin (Platform Owner)
# Secret key to authenticate as Super Bot Admin via /botadmin
BOT_ADMIN_SECRET="superadmin123"
# Optional comma-separated Telegram User IDs for automatic Super Bot Admin elevation (e.g. "123456789,987654321")
BOT_ADMIN_TELEGRAM_IDS=""

# Display / Telemetry Badges in Telegram replies (false by default for clean user experience)
SHOW_DEBUG_BADGES=false

